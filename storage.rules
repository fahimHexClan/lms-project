rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Materials — lecturers/admins upload, all signed-in users read
    match /materials/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024; // 50 MB limit
    }

    // Submissions — students upload their own only; lecturers/admins read
    match /submissions/{userId}/{assignmentId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024; // 25 MB limit
    }
  }
}
