rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper functions --------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isStudent()  { return getUserRole() == 'student'; }
    function isLecturer() { return getUserRole() == 'lecturer'; }
    function isAdmin()    { return getUserRole() == 'admin'; }
    function isStaff()    { return getUserRole() in ['lecturer', 'admin']; }

    // -- Users collection ----------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // -- User behaviour docs (BAGE source of truth) ---------------------------
    match /userBehaviour/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // -- Challenges (written by BAGE Cloud Function) --------------------------
    match /challenges/{challengeId} {
      // Student reads/views their own; admin reads all
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Completion is decided SERVER-SIDE ONLY by the BAGE Cloud Function
      // (which uses the Admin SDK and bypasses these rules entirely). No
      // client — not even the owning student — can mark a challenge
      // complete or change its reward directly; that would let a student
      // self-award points/badges without doing the actual behaviour.
      allow update: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // -- Milestones ------------------------------------------------------------
    match /milestones/{milestoneId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -- Materials (Content Library) --------------------------------------------
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // -- Assignments ---------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // -- Submissions -----------------------------------------------------------
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isStaff()
      );
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // -- Forum Threads ---------------------------------------------------------
    match /forumThreads/{threadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Any signed-in user can update (needed so repliers can increment
      // replyCount on threads they didn't author — forum collaboration)
      allow update: if isSignedIn();
      allow delete: if isStaff();
    }

    // -- Forum Replies ---------------------------------------------------------
    match /forumReplies/{replyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if resource.data.authorId == request.auth.uid || isStaff();
      allow delete: if isStaff();
    }

    // -- Events (Calendar) -------------------------------------------------------
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // -- Analytics / Reports (admin only) ----------------------------------------
    match /weeklyReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -- Batches & Courses (admin-managed lookup lists) --------------------------
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // -- Offerings: which courses a batch actually runs (Batch <-> Course pairs) --
    match /offerings/{offeringId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -- Video Lectures (YouTube links) -----------------------------------------
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // -- Badges collection (optional audit log) ----------------------------------
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
